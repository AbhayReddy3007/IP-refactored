# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────

# Gemini API key (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# AlloyDB private IP (from GCP console → AlloyDB → your cluster → Primary instance IP)
ALLOYDB_HOST=10.x.x.x

# AlloyDB password for the user below
ALLOYDB_PASSWORD=

# ── AUTHENTICATION ────────────────────────────────────────────────
# On a VM: ABSOLUTE path to your service account JSON key (keep it outside the repo).
# On Cloud Run: leave this UNSET — the job's attached service account is used automatically.
# Used for every BigQuery and GCS call. See docs/RUN_ON_LINUX_VM.md for the IAM roles it needs.
GOOGLE_APPLICATION_CREDENTIALS=/home/your-user/.secrets/ip-pipeline-sa.json

# ── GCP PROJECT ───────────────────────────────────────────────────
# Your GCP project ID (used for BigQuery jobs and GCS)
PROJECT_ID=your-gcp-project-id

# ── GCS ───────────────────────────────────────────────────────────
# GCS bucket that holds patent PDFs, caches and JSON snapshots
GCS_BUCKET=your-gcs-bucket

# Folder in GCS_BUCKET where patent PDFs live: gs://{GCS_BUCKET}/{GCS_PATENTS_PREFIX}/{DrugName}/*.pdf
GCS_PATENTS_PREFIX=Cognito_new/Master_patent_list

# ── ALLOYDB ───────────────────────────────────────────────────────
ALLOYDB_USER=postgres
ALLOYDB_DB=postgres
ALLOYDB_PORT=5432

# Embedding vector dimension — must match the Gemini embedding model output (3072 for gemini-embedding-001)
EMBEDDING_DIM=3072

# ── BIGQUERY ──────────────────────────────────────────────────────
# Fully-qualified table for patent master data (project.dataset.table)
PATENT_MASTER_TABLE=cognito-dev-380506.stage.patent_master

# Fully-qualified table for clinical efficacy / phase data
CLINICAL_EFFICACY_TABLE=cognito-dev-380506.data_mart.clinical_efficacy_glp1

# Fully-qualified (project.dataset.table) view with per-drug details (phase, LOE date, geography)
DRUG_DETAILS_TABLE=cognito-dev-380506.data_mart.vw_drug_details_full

# Fully-qualified view used to discover the GLP-1 drug list
DRUG_LIST_VIEW=cognito-prod-394707.cognito_prod_datamart.vw_drug_details_full

# Fully-qualified table where dimension scores are appended
DIM_SCORES_TABLE=cognito-prod-394707.cognito_prod_datamart.dimension_scores

# Fully-qualified brands table (optional; empty disables the BigQuery brand lookup)
BQ_BRANDS_TABLE=

# ── DRUG SELECTION ────────────────────────────────────────────────
# Set to a drug name to run a single drug, or leave empty to run all drugs.
# Accepts a comma-separated list: "Semaglutide, Tirzepatide"
# On the terminal you can also pass --drug "DrugName" instead.
DRUG_NAME=

# ── GEMINI MODELS (optional — defaults shown) ─────────────────────
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── STEP 2 — FORMULATION DATA (optional) ─────────────────────────
# Absolute path to the local Excel file with real-world formulation data.
# Used by blocking_analysis Step 2 to enrich claim-element matching.
# Leave empty to rely on patent claims alone.
FORMULATION_EXCEL_PATH=

# ── PUBMED / NCBI (optional — used by Step 3 evidence gathering) ──
PUBMED_EMAIL=your@email.com
NCBI_API_KEY=

# ── FORECASTED LOE MERGE PIPELINE ────────────────────────────────
# Source table: forecasted_loe (fully-qualified BigQuery table)
FORECASTED_LOE_TABLE=cognito-prod-394707.cognito_prod_datamart.forecasted_loe

# Output tables (fully-qualified). Each run replaces only that drug's rows.
BQ_PATENT_LOE_TABLE=cognito-prod-394707.cognito_prod_datamart.glp_patent_loe
BQ_MASTER_LOE_TABLE=cognito-prod-394707.cognito_prod_datamart.glp_master_loe

# JSON snapshot of each table:
#   gs://{GCS_BUCKET}/pipeline_cache/{GCS_JSON_EXPORT}/{table}/{drug}_{YYYYMMDD_HHMMSS}.json
GCS_JSON_EXPORT=loe_json_exports

# LOE (Primary Market) PDF reports. Layout inside the bucket:
#   {REPORT_GCS_PATH}/{drug}/IP/Primary Market Entry Horizon.pdf
#   {REPORT_GCS_PATH}/{drug}/IP/archive/Primary Market Entry Horizon+{timestamp}.pdf
# REPORT_GCS_BUCKET defaults to GCS_BUCKET when empty.
REPORT_GCS_BUCKET=
REPORT_GCS_PATH=Cognito_new/reports

# Set to true to keep forecasted rows for Marketed/Pre-registration drugs.
# Default (false): real LOE data supersedes their forecasted rows.
NO_MARKETED_SKIP=false

# ── TUNABLES (optional — defaults are production-ready) ───────────
# ANALYSIS_CONCURRENCY=5
# INDEXER_CONCURRENCY=10
# MAX_ANALYSIS_RETRIES=3
# ALLOYDB_CONNECT_TIMEOUT=30
# ALLOYDB_RETRY_COUNT=3
